---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const contactHref = currentPath === '/' ? '#contact' : '/#contact';
const links = [
  ['/', 'Home'],
  ['/missions/', 'Missions'],
  ['/lab/', 'Lab']
] as const;
---

<header class="site-nav">
  <div class="nav-inner">
    <a class="site-brand" href="/">Maxime de Visscher</a>
    <nav aria-label="Primary navigation">
      {links.map(([href, label]) => (
        <a class="nav-link" href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>
      ))}
      <a class="contact-link" href={contactHref}>Get in touch</a>
      <a class="social-link" href="https://be.linkedin.com/in/maximedevisscher" aria-label="View Maxime de Visscher on LinkedIn" rel="noopener noreferrer" target="_blank">
        <img src="/static/img/logos/linkedIn.svg" alt="" width="31" height="32" />
      </a>
    </nav>
  </div>
</header>
