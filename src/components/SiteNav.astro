---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
const home = currentPath === '/';
const pageLabel = currentPath === '/lab/' ? 'lab' : currentPath === '/experience/' ? 'experience' : null;
---
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-inner">
    <div class="brand-lockup">
      <a class="brand" href={home ? '#main' : '/'}>Maxime de Visscher</a>
      {pageLabel && <span class="brand-page">/ {pageLabel}</span>}
    </div>
    <nav aria-label="Main navigation">
      <a href="/experience/" aria-current={currentPath === '/experience/' ? 'page' : undefined}>Experience</a>
      <a href="/lab/" aria-current={currentPath === '/lab/' ? 'page' : undefined}>Lab</a>
      <a class="nav-contact" href={home ? '#contact' : '/#contact'}>Get in touch ↗</a>
    </nav>
  </div>
</header>
