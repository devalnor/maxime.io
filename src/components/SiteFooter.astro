---
import ArrowIcon from './ArrowIcon.astro';
interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const palettes = [
  { color: '#e9aa98', hue: 12, label: 'Rose copper' },
  { color: '#91acf0', hue: 222, label: 'Mineral blue' },
  { color: '#a0d9bc', hue: 150, label: 'Jade' },
  { color: '#e5c18c', hue: 35, label: 'Amber' },
  { color: '#381f56', hue: 267.27, label: 'Deep violet' }
];
---

<footer>
  <div class="wrap footer-inner">
    <span>© {new Date().getFullYear()}</span>
    {home && (
      <details class="palette-picker">
        <summary aria-label="Choose color palette" title="Choose color palette">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a9 9 0 1 0 0 18h1.5a2.5 2.5 0 0 0 1.8-4.2 1.5 1.5 0 0 1 1.1-2.6H18a3 3 0 0 0 3-3C21 6.7 17 3 12 3Z" />
            <circle cx="7.5" cy="10" r="1" />
            <circle cx="10.5" cy="6.8" r="1" />
            <circle cx="15" cy="7.2" r="1" />
            <circle cx="17.5" cy="10.5" r="1" />
          </svg>
        </summary>
        <div class="appearance" role="group" aria-label="Appearance">
        {palettes.map(({ color, hue, label }) => (
          <button
            class="swatch"
            style={`--swatch:${color}`}
            data-hue={hue}
            aria-label={`${label} palette`}
            aria-pressed={hue === 12 ? 'true' : 'false'}
          ></button>
        ))}
        <label class="custom-color">
          Custom
          <input id="color" type="color" value="#e9aa98" aria-label="Choose palette color" />
        </label>
        </div>
      </details>
    )}
    <a class="backtop" href={home ? '#main' : '/'}>
      {home ? 'Back to top' : 'Home'} <ArrowIcon direction="up" />
    </a>
  </div>
</footer>
