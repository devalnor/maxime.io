---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import BusinessIcon from '../components/skills/BusinessIcon.astro';
import DesignIcon from '../components/skills/DesignIcon.astro';
import TechnologyIcon from '../components/skills/TechnologyIcon.astro';

const skills = [
  {
    title: 'Business',
    icon: 'business',
    items: ['Customer Experience', 'Technical Presales', 'Digital Strategy', 'Client Collaboration']
  },
  {
    title: 'Design',
    icon: 'design',
    items: ['UX Architecture', 'Information Architecture', 'Interaction Design', 'Training']
  },
  {
    title: 'Technology',
    icon: 'technology',
    items: ['Senior Front-end Development', 'Mobile Development', 'Prototyping & R&D', 'AI & IoT Exploration']
  }
];

const periods = [
  {
    years: '1999–2006',
    title: 'Building for the early web',
    copy: "At B. On The Net & Net Events, I built dynamic websites, content management systems and services for some of Belgium's early online platforms. Those years taught me to learn by making and to understand a digital product all the way down to the code."
  },
  {
    years: '2006–2011',
    title: 'Connecting technology and business',
    copy: "Technical presales put me between a client's ambition and the people who had to build it. I learned to question a brief, explain technical choices without theatre and turn an unclear request into something a team could actually make."
  },
  {
    years: '2011–2019',
    title: 'Designing digital experiences',
    copy: 'During thirteen years with Emakina, my work shifted towards information architecture, UX and digital strategy while staying close to technology. I worked across many sectors and small missions, usually where business goals, user needs and implementation constraints met.'
  },
  {
    years: '2021–today',
    title: 'Shaping a product at scale',
    copy: 'Since 2021, I have worked with Mbrella as a freelance UX Architect. It is my most recent long-term client mission and a chance to help a product, a team and my own practice grow together.'
  },
  {
    years: 'Ongoing',
    title: 'Exploring what comes next',
    copy: 'I keep time for experiments in AI, IoT and whatever else looks promising enough to test. Some become useful product ideas. Others simply teach me where the technology still falls short.'
  }
];

const sectors = [
  ['Agencies I worked for', ['DogStudio', 'Empathy Lab (formerly Emakina)']],
  ['Automotive', ['Audi', 'Interlease', 'Mercedes-Benz']],
  ['Art, Tourism and Entertainment', ['Dragone', 'Musée d’Orsay', 'Pairi Daiza']],
  ['FMCG', ['Bongrain', 'Mandarine Napoleon', 'Stassen', 'Vins de Bordeaux']],
  ['Financial services', ['Axa Bank', 'BCGE', 'Beo Bank', 'BKCP', 'Dutch Bank', 'Keytrade Bank']],
  ['Industrial and Energy', ['Baxter', 'Engie', 'Ores', 'Services industriels de Genève (SIG)', 'Thomas & Pirons']],
  ['Institution, Education and Associations', ["Belgium's Chancellery of the Prime Minister", 'CLL', 'Education Above All Fundation', 'European Parliament', 'IHECS Academy']],
  ['Media', ['BBC Sport', 'IPM', 'Net Events', 'RMB', 'RTBF Auvio']],
  ['Publishing', ['Casterman', 'Dargaud', 'Dupuis', 'Editions Delagrave', 'J’ai lu', 'Le Lombard']],
  ['Retail and distribution', ['Cuisine Plus', 'Dufry', 'Eastpak', 'Ixina', 'Levi’s', 'The Phone House']],
  ['Travel and transportation', ['Aegean', 'De Lijn', 'Europe Assistance', 'OuiBus', 'TEC', 'Thalys', 'Touring Assistance']],
  ['Telecom', ['Belgacom', 'Join Experience', 'Proximus', 'Orange', 'VOO']]
] as const;
---

<BaseLayout
  title="Maxime de Visscher | Creative Technologist & UX Architect"
  description="Senior front-end developer and UX architect working across digital products, emerging technology and independent experiments."
  introFade={true}
>
  <SiteNav currentPath="/" />

  <main>
    <section class="hero">
      <div class="hero-photo" role="img" aria-label="Portrait of Maxime de Visscher"></div>
      <div class="hero-content">
        <div class="identity">
          <span class="role">Creative Technologist & UX Architect</span>
        </div>
        <h1>Using technology to bring user experience and business goals together <u>is what drives me</u>.</h1>
        <p class="intro">I am a senior front-end developer and UX architect. I work between research, interface design and code, especially on problems that do not fit neatly inside one role. I have spent my career learning new technologies early, testing them in real situations and keeping what proves useful.</p>
      </div>
    </section>

    <section class="skills" aria-label="Areas of expertise">
      <div class="skills-grid reveal">
        {skills.map((skill) => (
          <article class="skill-card">
            <h2>{skill.title}</h2>
            <div class={`skill-icon ${skill.icon}`} aria-hidden="true">
              {skill.icon === 'business' && <BusinessIcon />}
              {skill.icon === 'design' && <DesignIcon />}
              {skill.icon === 'technology' && <TechnologyIcon />}
            </div>
            <ul>{skill.items.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section class="evolution" aria-labelledby="evolution-title">
      <div class="evolution-inner reveal">
        <div class="section-intro">
          <h2 id="evolution-title">The work keeps changing</h2>
          <p>I started building for the web in 1999. Since then, my work has moved through development, technical presales, digital strategy, UX architecture, mobile products and applied AI. The job titles changed because the problems changed. I kept learning, making and connecting disciplines that are too often handled in isolation.</p>
        </div>
        <div class="periods">
          {periods.map((period) => (
            <article class="period">
              <span class="period-years">{period.years}</span>
              <h3>{period.title}</h3>
              <p>{period.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="customers">
      <div class="customers-inner reveal">
        <h2>Selected clients and organizations I’ve worked with</h2>
        <p class="customers-note">This includes work delivered as part of agency teams.</p>
        <div class="sector-grid">
          {sectors.map(([title, organizations]) => (
            <article class="sector">
              <h3>{title}</h3>
              <ul>{organizations.map((organization) => <li>{organization}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="contact-inner">
        <div class="contact-photo" role="img" aria-label="Portrait of Maxime de Visscher"></div>
        <div class="contact-content">
          <h2>Get in touch</h2>
          <p>If you care about how technology is made and used, we will probably have something to talk about.</p>
          <a class="email-button" href="mailto:maxime@macoal.com" aria-label="Send Maxime de Visscher an email">Send me an email</a>
          <div class="socials">
            <a href="https://github.com/devalnor" target="_blank" aria-label="View Maxime de Visscher on GitHub" rel="noopener noreferrer"><img src="/static/img/logos/github.svg" alt="" width="44" height="44" /></a>
            <a href="https://be.linkedin.com/in/maximedevisscher" target="_blank" aria-label="View Maxime de Visscher on LinkedIn" rel="noopener noreferrer"><img src="/static/img/logos/linkedIn.svg" alt="" width="44" height="44" /></a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer><div>© 2020–{new Date().getFullYear()} Macoal</div></footer>

</BaseLayout>
