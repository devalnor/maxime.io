---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TechnologyIcon from '../components/skills/TechnologyIcon.astro';
import DesignIcon from '../components/skills/DesignIcon.astro';
import BusinessIcon from '../components/skills/BusinessIcon.astro';
---
<BaseLayout
  title="Maxime de Visscher — Creative Technologist & UX Architect"
  description="Creative Technologist & UX Architect. Design, technology and independent experiments."
>
  <div
    id="portrait-scene"
    role="img"
    aria-label="A copper three-dimensional particle portrait forming from a flock of boids"
  >
    <canvas id="flock" aria-hidden="true"></canvas>
  </div>
  <SiteNav currentPath="/" />
  <main id="main">
    <section class="wrap hero" aria-labelledby="intro-title">
      <figure class="portrait"></figure>
      <div class="hero-copy">
        <p class="eyebrow">Creative Technologist & UX Architect</p>
        <h1 id="intro-title">
          Putting human experience at the heart of technology{' '}
          <em>is what drives me.</em>
        </h1>
        <p class="intro">
          I am a senior front-end developer and UX architect. I work between research, interface
          design and code, especially on problems that do not fit neatly inside one role. I have
          spent my career learning new technologies early, testing them in real situations and
          keeping what proves useful.
        </p>
        <div class="hero-links">
          <a class="text-link" href="/experience/"
            >Explore my experience <span aria-hidden="true">↗</span></a
          ><a class="text-link" href="/lab/">Visit the Lab <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
    <section class="expertise" aria-label="Areas of expertise">
      <div class="expertise-grid">
        <article class="expertise-card">
          <h2>Technology</h2>
          <div class="expertise-icon" aria-hidden="true"><TechnologyIcon /></div>
          <ul>
            <li>Senior Front-end Development</li>
            <li>Mobile Development</li>
            <li>Prototyping &amp; R&amp;D</li>
            <li>AI &amp; IoT Exploration</li>
          </ul>
        </article>
        <article class="expertise-card">
          <h2>Design</h2>
          <div class="expertise-icon" aria-hidden="true"><DesignIcon /></div>
          <ul>
            <li>UX Architecture</li>
            <li>Information Architecture</li>
            <li>Interaction Design</li>
            <li>Training</li>
          </ul>
        </article>
        <article class="expertise-card">
          <h2>Business</h2>
          <div class="expertise-icon" aria-hidden="true"><BusinessIcon /></div>
          <ul>
            <li>Customer Experience</li>
            <li>Technical Presales</li>
            <li>Digital Strategy</li>
            <li>Client Collaboration</li>
          </ul>
        </article>
      </div>
    </section>
    <section id="about" class="section wrap" aria-labelledby="about-title">
      <div class="about-intro">
        <h2 id="about-title">From the early web to <span>applied AI</span>.</h2>
        <p>
          I started building for the web in 1999. Since then, my work has moved through development,
          technical presales, digital strategy, UX architecture, mobile products and applied AI. The
          job titles changed because the problems changed. I kept learning, making and connecting
          disciplines that are too often handled in isolation.
        </p>
      </div>
      <div class="periods">
        <article class="period">
          <time class="period-years">1999–2006</time>
          <div>
            <h3>Building for the early web</h3>
            <p>
              At B. On The Net &amp; Net Events, I built dynamic websites, content management
              systems and services for some of Belgium's early online platforms. Those years taught
              me to learn by making and to understand a digital product all the way down to the
              code.
            </p>
          </div>
        </article>
        <article class="period">
          <time class="period-years">2006–2011</time>
          <div>
            <h3>Connecting technology and business</h3>
            <p>
              Technical presales put me between a client's ambition and the people who had to build
              it. I learned to question a brief, explain technical choices without theatre and turn
              an unclear request into something a team could actually make.
            </p>
          </div>
        </article>
        <article class="period">
          <time class="period-years">2011–2019</time>
          <div>
            <h3>Designing digital experiences</h3>
            <p>
              During thirteen years with Emakina, my work shifted towards information architecture,
              UX and digital strategy while staying close to technology. I worked across many
              sectors and small missions, usually where business goals, user needs and
              implementation constraints met.
            </p>
          </div>
        </article>
        <article class="period">
          <time class="period-years">2021–today</time>
          <div>
            <h3>Shaping a product at scale</h3>
            <p>
              Since 2021, I have worked with Mbrella as UX Architect. It is my most recent long-term
              client mission and a chance to help a product, a team and my own practice grow
              together.
            </p>
          </div>
        </article>
        <article class="period">
          <time class="period-years">Ongoing</time>
          <div>
            <h3>Exploring what comes next</h3>
            <p>
              I keep time for experiments in AI, IoT and whatever else looks promising enough to
              test. Some become useful product ideas. Others simply teach me where the technology
              still falls short.
            </p>
          </div>
        </article>
      </div>
    </section>
    <section id="contact" class="contact wrap" aria-labelledby="contact-title">
      <div class="contact-inner">
        <div class="contact-main">
          <h2 id="contact-title">Let’s talk.</h2>
          <p>
            If you care about how technology is made and used, we will probably have something to
            talk about.
          </p>
          <a class="contact-cta" href="mailto:maxime@macoal.com?subject=Let%E2%80%99s%20talk"
            >Start a conversation <span aria-hidden="true">↗</span></a
          >
          <div class="contact-secondary">
            <a
              href="https://be.linkedin.com/in/maximedevisscher"
              target="_blank"
              rel="noopener noreferrer"
              >LinkedIn ↗</a
            ><a href="https://github.com/devalnor" target="_blank" rel="noopener noreferrer"
              >GitHub ↗</a
            >
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter home />
  <script is:inline type="module" src="/static/portrait/script.js"></script>
</BaseLayout>
